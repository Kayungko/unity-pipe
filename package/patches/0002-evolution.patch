+
+            var after = MaterialCommands.GetMaterialProperties(handle).Shader;
+            Assert.AreEqual(before, after, "a shader_not_found must write nothing");
+        }
+
+        // ---- keywords -----------------------------------------------------------------------------
+
+        [Test]
+        public void Set_Keyword_EnableThenDisable()
+        {
